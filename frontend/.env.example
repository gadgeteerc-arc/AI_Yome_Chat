# ==========================================
# AI_Yome_Chat Frontend Environment Variables (Vite)
# ==========================================
# 
# このファイルを `.env` にコピーして、必要に応じてポートや接続先を書き換えてください。
# Viteの仕様により、変数名は必ず `VITE_` で始める必要があります。
#

# WebSocketサーバーの接続先（バックエンドのポートに合わせる、デフォルト: ws://localhost:3001）
VITE_WS_URL=ws://localhost:3001

# バックエンドAPI（メッセージ送信）の接続先（デフォルト: http://localhost:3001/api/chat）
VITE_API_URL=http://localhost:3001/api/chat
